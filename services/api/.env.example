# Copy to .env and fill in. Never commit real keys.

# Preferred: OpenRouter (live / portfolio)
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta/muse-spark-1.3-contributor
# minimal | low | medium | high | xhigh. "max" is sent as xhigh.
LLM_REASONING_EFFORT=medium

# Or direct DeepSeek (local dev)
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

XAI_API_KEY=
